# Copy to .env.local and fill in. Both public values are safe in the browser —
# they identify the dataset, they do not grant access to it.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-19

# Server-only. A Viewer token, used for reads and for draft mode.
# Create at sanity.io/manage -> API -> Tokens. Never commit the value.
SANITY_API_READ_TOKEN=

# Server-only. Shared secret the Sanity webhook signs its POST to
# /api/revalidate with. Generate any long random string.
SANITY_REVALIDATE_SECRET=

# Server-only, and only needed to run `npm run seed`. Editor permissions —
# a Viewer token cannot create documents. Nothing at runtime reads this, so
# leave it out of the deployment and revoke it once the dataset is populated.
SANITY_API_WRITE_TOKEN=

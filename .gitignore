# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which holds no values and is the only record of
# which variables the project needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Intermediate output of `sanity schema extract`, regenerated on demand.
# sanity/lib/generated.ts is committed; this is not.
sanity/extract.json

# Lighthouse raw reports. The screenshots in docs/ are what is committed.
lighthouse*.report.*

# Zodiak, fetched from Fontshare by scripts/fetch-fonts.mjs on predev and
# prebuild. Its licence permits self-hosting the deployed site but not
# redistribution, and this repo is public, so the file cannot live in it.
app/fonts/
